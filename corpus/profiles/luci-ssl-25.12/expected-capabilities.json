{
  "profile": "luci-ssl-25.12",
  "notes": [
    "These are independently justified intended capabilities, not a copy of acl.d grants.",
    "Copying every grant into this file would make violations impossible by construction.",
    "Synthetic roles below are labeled synthetic; they are not stock-device logins."
  ],
  "expectations": [
    {
      "expectation_id": "unauthenticated-getFeatures",
      "session_class": "unauthenticated",
      "ingress": "ubus_http",
      "entrypoint_id": "ubus_http:luci.getFeatures",
      "intended_access": [
        {
          "target_id": "ubus:luci.getFeatures",
          "op": "invoke"
        }
      ],
      "allowed_helper_effects": [
        {
          "sink_kind": "popen",
          "constraint": "fixed_command",
          "examples": [
            "opkg list-installed netifd",
            "apk list -I netifd",
            "dnsmasq --version",
            "odhcpd -h",
            "ipset --help"
          ]
        },
        {
          "sink_kind": "system",
          "constraint": "fixed_command",
          "examples": [
            "hostapd -v<feature>",
            "wpa_supplicant -v<feature>",
            "/etc/init.d/ufp running"
          ],
          "coverage": "m4 GetFeaturesDirectExec.ql records hostapd/wpa_supplicant system() call sites; wifi_features loop is not unrolled"
        }
      ],
      "denied_authority": [
        "uci write",
        "file write",
        "file.exec",
        "cgi-io backup",
        "command construction from request.args"
      ],
      "if_fixed_helpers_reach_popen": "intended_access",
      "rationale": "Stock luci-base unauthenticated ACL grants only ubus luci getFeatures. getFeatures.call takes no request.args. callPackageVersionCheck interpolates a literal package name through shellquote.",
      "review_provenance": [
        "openwrt/luci@b2e0be4b46ec0fd43394c081fa7c50657af14011 modules/luci-base/root/usr/share/rpcd/acl.d/luci-base.json unauthenticated.luci.getFeatures",
        "openwrt/luci@b2e0be4b46ec0fd43394c081fa7c50657af14011 modules/luci-base/root/usr/share/rpcd/ucode/luci getFeatures.call and callPackageVersionCheck"
      ]
    },
    {
      "expectation_id": "root-administration",
      "session_class": "root",
      "ingress": "ubus_http",
      "intended_access": [
        {
          "target_id": "*",
          "op": "read"
        },
        {
          "target_id": "*",
          "op": "write"
        }
      ],
      "rationale": "Stock rpcd login for root is read/write '*'. A tainted construction used only by this caller is a code-review candidate, not an authorization_violation, unless evidence shows an additional crossed boundary.",
      "review_provenance": [
        "openwrt/rpcd@d99f703e4035d03fbcfbada3cb697db346c2b984 package overlay rpcd.config root read/write '*'"
      ]
    },
    {
      "expectation_id": "luci-mod-network-swconfig",
      "session_class": "luci-mod-network-config",
      "ingress": "ubus_http",
      "intended_access": [
        {
          "target_id": "ubus:luci.getSwconfigFeatures",
          "op": "invoke"
        },
        {
          "target_id": "ubus:luci.getSwconfigPortState",
          "op": "invoke"
        }
      ],
      "allowed_helper_effects": [
        {
          "sink_kind": "popen",
          "constraint": "fixed_executable_quoted_arg",
          "examples": [
            "swconfig dev <quoted switch> help",
            "swconfig dev <quoted switch> show"
          ]
        }
      ],
      "denied_authority": [
        "unauthenticated invoke",
        "arbitrary executable selection"
      ],
      "rationale": "luci-mod-network-config grants read of luci getSwconfigFeatures/getSwconfigPortState as switch diagnostics. Unauthenticated ACLs do not name these methods. A quoted complete argument to a fixed swconfig executable is intended diagnostic access for that ACL group, not BAC. shellquote is not treated as a global sanitizer.",
      "review_provenance": [
        "openwrt/luci@b2e0be4b46ec0fd43394c081fa7c50657af14011 modules/luci-mod-network/root/usr/share/rpcd/acl.d/luci-mod-network.json luci-mod-network-config"
      ]
    },
    {
      "expectation_id": "luci-mod-status-realtime",
      "session_class": "luci-mod-status-realtime",
      "ingress": "ubus_http",
      "intended_access": [
        {
          "target_id": "ubus:luci.getRealtimeStats",
          "op": "invoke"
        }
      ],
      "allowed_helper_effects": [
        {
          "sink_kind": "popen",
          "constraint": "fixed_executable_quoted_arg",
          "examples": ["luci-bwc -i|-r <quoted device>"]
        }
      ],
      "denied_authority": [
        "unauthenticated invoke",
        "arbitrary executable selection"
      ],
      "rationale": "luci-mod-status-realtime grants read of luci getRealtimeStats. Unauthenticated ACLs do not name it.",
      "review_provenance": [
        "openwrt/luci@b2e0be4b46ec0fd43394c081fa7c50657af14011 modules/luci-mod-status/root/usr/share/rpcd/acl.d/luci-mod-status.json luci-mod-status-realtime"
      ]
    },
    {
      "expectation_id": "luci-mod-system-setPassword",
      "session_class": "luci-mod-system-config",
      "ingress": "ubus_http",
      "entrypoint_id": "ubus_http:luci.setPassword",
      "intended_access": [
        {
          "target_id": "ubus:luci.setPassword",
          "op": "invoke"
        }
      ],
      "denied_authority": [
        "unauthenticated invoke"
      ],
      "rationale": "luci-mod-system-config write grants luci.setPassword. Unauthenticated setPassword is already a M2 deny. Password change by an authorized admin is intended_access; taint into busybox passwd remains a code-review candidate, not BAC, unless an extra boundary is crossed.",
      "review_provenance": [
        "openwrt/luci@b2e0be4b46ec0fd43394c081fa7c50657af14011 modules/luci-mod-system/root/usr/share/rpcd/acl.d/luci-mod-system.json luci-mod-system-config",
        "policy:decision:unauthenticated-setPassword-deny"
      ]
    },
    {
      "expectation_id": "luci-mod-system-setLocaltime",
      "session_class": "luci-mod-system-config",
      "ingress": "ubus_http",
      "entrypoint_id": "ubus_http:luci.setLocaltime",
      "intended_access": [
        {
          "target_id": "ubus:luci.setLocaltime",
          "op": "invoke"
        }
      ],
      "denied_authority": [
        "unauthenticated invoke"
      ],
      "rationale": "luci-mod-system-config write grants luci.setLocaltime. The handler runs date via sprintf of localtime() fields. Unauthenticated ACLs do not name this method.",
      "review_provenance": [
        "openwrt/luci@b2e0be4b46ec0fd43394c081fa7c50657af14011 modules/luci-mod-system/root/usr/share/rpcd/acl.d/luci-mod-system.json luci-mod-system-config"
      ]
    },
    {
      "expectation_id": "synthetic-diagnostic-exec",
      "session_class": "synthetic-diagnostic",
      "synthetic": true,
      "intended_access": [
        {
          "constraint": "fixed_executable_exec",
          "note": "Bare-exe file.exec means arbitrary arguments to that executable, not arbitrary executable selection or demonstrated RCE."
        }
      ],
      "denied_authority": [
        "arbitrary executable selection",
        "uci/file writes outside the diagnostic grant"
      ]
    },
    {
      "expectation_id": "synthetic-backup-read",
      "session_class": "synthetic-backup",
      "synthetic": true,
      "intended_access": [
        {
          "target_id": "cgi_endpoint:cgi-backup",
          "op": "read"
        }
      ],
      "note": "A backup read is not a violation merely because the role lacks write permission. Unauthorized roles holding the grant are assessed against their own expectation."
    }
  ]
}
