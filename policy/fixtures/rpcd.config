config rpcd
	option socket /var/run/ubus/ubus.sock
	option timeout 30

config login
	option username 'root'
	option password '$p$root'
	list read '*'
	list write '*'

# Fixture sessions (not stock). Usernames are luci-ssl ACL groups used as
# delegated session_class values for inventoried luci exec methods,
# cgi-backup, cgi-exec file.exec of luci-ssl libexec helpers,
# luci-mod-status dmesg/firewall cgi-exec file.exec, and
# luci-mod-status iptables -Z / routes ip ubus file.exec, and
# luci-mod-network-config ifup/ifdown/wifi ubus file.exec, and
# luci-mod-status-processes /bin/kill ubus file.exec, and
# luci-mod-system-mounts umount/block mount ubus file.exec, and
# luci-mod-system-flash sysupgrade --list-backup ubus file.exec (list read), and
# luci-mod-system-reboot system.reboot, and
# luci-mod-system-init rc.init, and
# luci-mod-system-init-read rc.list, and
# luci-mod-network-config-write / luci-mod-status-index-wifi hostapd.del_client.
config login
	option username 'luci-mod-network-config'
	list read 'luci-mod-network-config'

config login
	option username 'luci-mod-network-config-write'
	list write 'luci-mod-network-config'

config login
	option username 'luci-mod-status-realtime'
	list read 'luci-mod-status-realtime'

config login
	option username 'luci-mod-system-config'
	list write 'luci-mod-system-config'

config login
	option username 'luci-mod-system-flash'
	list read 'luci-mod-system-flash'

config login
	option username 'luci-mod-system-mounts'
	list read 'luci-mod-system-mounts'
	list write 'luci-mod-system-mounts'

config login
	option username 'luci-mod-status-processes'
	list read 'luci-mod-status-processes'

config login
	option username 'luci-mod-status-processes-write'
	list write 'luci-mod-status-processes'

config login
	option username 'luci-mod-status-logs'
	list read 'luci-mod-status-logs'

config login
	option username 'luci-app-package-manager'
	list read 'luci-app-package-manager'
	list write 'luci-app-package-manager'

config login
	option username 'luci-mod-status-firewall'
	list read 'luci-mod-status-firewall'
	list write 'luci-mod-status-firewall'

config login
	option username 'luci-mod-status-firewall-read'
	list read 'luci-mod-status-firewall'

config login
	option username 'luci-mod-status-routes'
	list read 'luci-mod-status-routes'

config login
	option username 'luci-mod-status-routes-json'
	list read 'luci-mod-status-routes-json'

config login
	option username 'luci-mod-system-reboot'
	list write 'luci-mod-system-reboot'

config login
	option username 'luci-mod-system-init'
	list write 'luci-mod-system-init'

config login
	option username 'luci-mod-system-init-read'
	list read 'luci-mod-system-init'

config login
	option username 'luci-mod-status-index-wifi'
	list write 'luci-mod-status-index-wifi'

